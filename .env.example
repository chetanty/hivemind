# Copy to .env.local. All optional: defaults work with `npm run llm:setup` + `npm run llm`.

# "llamacpp" (default: any OpenAI-compatible server) or "ollama"
LLM_PROVIDER=
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=local
LLM_API_KEY=

# Only if LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# "mock" forces template data even when a model is running
SIM_ENGINE=

# M4+: Postgres + pgvector (Supabase or Neon)
DATABASE_URL=
